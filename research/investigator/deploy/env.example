# Template for the environment file at /etc/human-music/env.
# Owner root, group human-music, mode 640. Never commit a filled-in copy.

# Written by tools/make-key.mjs: the SHA-256 of the derived key, never the key itself.
HM_KEY_HASH=
# Claude Code login for the service, from `claude setup-token` (run once by the owner).
CLAUDE_CODE_OAUTH_TOKEN=
# Key for the SH Labs second opinion. Leave empty to skip that check.
SHLABS_API_KEY=
# Deep investigations per day. Empty means the default of 100.
HM_DAILY_CAP=
# The one origin allowed to call the service from a browser: the extension's own origin.
HM_ALLOWED_ORIGIN=
# Folder for the database and reports. Must be the folder the unit may write to.
HM_DATA_DIR=
# Git remote that receives the published verdict list.
HM_PUBLISH_REMOTE=
# Path to the deploy key used for publishing, readable only by the service's user.
HM_PUBLISH_KEY_PATH=
# Unix socket the service listens on. Empty means /run/human-music/investigator.sock.
# Must match the socket path in the nginx snippet.
HM_SOCKET=

# Evidence scoring: Claude fills in the evidence checklist and src/score.mjs decides (the default,
# approved 2026-11-18). "off" goes back to Claude's own number.
HM_SCORING=
