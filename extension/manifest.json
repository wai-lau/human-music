{
  "manifest_version": 3,
  "name": "Human Music",
  "version": "0.1.2",
  "description": "Keeps your YouTube Music and Spotify listening to music made by people.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://music.youtube.com/*",
    "https://open.spotify.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "src/core/text.js",
        "src/core/store.js",
        "src/core/match.js",
        "src/core/lists.js",
        "src/core/settings.js",
        "src/core/log.js",
        "src/core/lookahead.js",
        "src/core/skipper.js",
        "src/page/common.js",
        "src/page/ytm.js",
        "src/content.js"
      ]
    },
    {
      "matches": [
        "https://open.spotify.com/*"
      ],
      "js": [
        "src/core/text.js",
        "src/core/store.js",
        "src/core/match.js",
        "src/core/lists.js",
        "src/core/settings.js",
        "src/core/log.js",
        "src/core/lookahead.js",
        "src/core/skipper.js",
        "src/page/common.js",
        "src/page/spotify.js",
        "src/content.js"
      ]
    }
  ]
}
